{
  "name": "@tourwerk/api",
  "private": true,
  "version": "1.0.0",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "dev": "prisma generate >/dev/null && tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "db:deploy": "prisma migrate deploy && prisma generate",
    "typecheck": "prisma generate >/dev/null && tsc --noEmit -p tsconfig.json",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest --runInBand --forceExit"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/test"],
    "globalSetup": "<rootDir>/test/global-setup.ts",
    "testTimeout": 30000,
    "transform": {
      "^.+\\.ts$": ["ts-jest", { "tsconfig": "tsconfig.json", "diagnostics": { "ignoreCodes": ["TS151001", "TS151002"] } }]
    },
    "moduleNameMapper": { "^(\\.{1,2}/.*)\\.js$": "$1" }
  }
}
