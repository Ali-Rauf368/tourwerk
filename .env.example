# Copy to apps/api/.env for local overrides. Everything has a working development default.
# DATABASE_URL=postgresql://tourwerk@127.0.0.1:5442/tourwerk
# MONGO_URL=mongodb://127.0.0.1:27017/tourwerk      # empty = in-memory telemetry
# MYSQL_URL=mysql://tourwerk:tourwerk@127.0.0.1:3306/erp   # empty = in-memory ERP outbox
# JWT_SECRET=at-least-16-characters   # also signs tracking links; unset = random per start, so old links stop working
# INTEGRATION_TOKEN=at-least-16-characters
# OPTIMIZER_SEARCH_MS=1500 # ALNS time budget per optimization (0 = construction only)
# SIM_JAM_RATE=0.12        # share of simulated legs that hit congestion
# SIM_SPEEDUP=90          # simulated seconds per real second
# SIM_TICK_MS=700
# SIM_FAIL_RATE=0.04
