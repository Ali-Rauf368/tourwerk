{
  "flowContents": {
    "identifier": "8477a066-34ea-50ae-a8ac-ad2314fc76da",
    "name": "Tourwerk order intake",
    "comments": "Webshop CSV exports -> Tourwerk REST API (idempotent by externalRef); periodic ERP export trigger.",
    "processors": [
      {
        "identifier": "5c76b003-3978-5e7a-8f80-b93aca883f32",
        "name": "List webshop exports",
        "type": "org.apache.nifi.processors.standard.ListFile",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "2.0.0"
        },
        "position": {
          "x": 0,
          "y": 0
        },
        "properties": {
          "Input Directory": "/data/webshop/incoming",
          "File Filter": "webshop-orders-.*\\.csv",
          "Minimum File Age": "10 sec"
        },
        "schedulingPeriod": "30 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "autoTerminatedRelationships": [],
        "componentType": "PROCESSOR"
      },
      {
        "identifier": "d3801173-293f-54e2-914a-59e74ae9ea72",
        "name": "Fetch CSV",
        "type": "org.apache.nifi.processors.standard.FetchFile",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "2.0.0"
        },
        "position": {
          "x": 0,
          "y": 200
        },
        "properties": {
          "File to Fetch": "${absolute.path}/${filename}",
          "Completion Strategy": "Move File",
          "Move Destination Directory": "/data/webshop/processed"
        },
        "schedulingPeriod": "0 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "autoTerminatedRelationships": [
          "not.found",
          "permission.denied"
        ],
        "componentType": "PROCESSOR"
      },
      {
        "identifier": "17011fd6-4ace-57c3-a26e-8fc1a80179a3",
        "name": "CSV to JSON",
        "type": "org.apache.nifi.processors.standard.ConvertRecord",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "2.0.0"
        },
        "position": {
          "x": 0,
          "y": 400
        },
        "properties": {
          "Record Reader": "282aaaca-2e5a-59cf-922f-e2ee18bffdbc",
          "Record Writer": "ed3fa77d-e6e8-52db-8d25-8ff9a57179b0"
        },
        "schedulingPeriod": "0 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "autoTerminatedRelationships": [],
        "componentType": "PROCESSOR"
      },
      {
        "identifier": "96bce3c5-f1ef-5f62-b80a-950ab32af50c",
        "name": "Wrap as batch",
        "type": "org.apache.nifi.processors.standard.JoltTransformJSON",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "2.0.0"
        },
        "position": {
          "x": 0,
          "y": 600
        },
        "properties": {
          "Jolt Transformation DSL": "Shift",
          "Jolt Specification": "{\"*\": \"orders[]\"}"
        },
        "schedulingPeriod": "0 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "autoTerminatedRelationships": [],
        "componentType": "PROCESSOR"
      },
      {
        "identifier": "aa9deaf2-5095-55b7-b9d0-f8f4a5bc3b9c",
        "name": "POST to Tourwerk",
        "type": "org.apache.nifi.processors.standard.InvokeHTTP",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "2.0.0"
        },
        "position": {
          "x": 0,
          "y": 800
        },
        "properties": {
          "HTTP Method": "POST",
          "HTTP URL": "${TOURWERK_API_URL:replaceNull('http://api:4600')}/api/integration/orders",
          "Request Content-Type": "application/json",
          "x-integration-token": "#{integration_token}",
          "x-source": "webshop",
          "Connection Timeout": "10 secs",
          "Socket Read Timeout": "60 secs"
        },
        "schedulingPeriod": "0 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "autoTerminatedRelationships": [
          "Original"
        ],
        "componentType": "PROCESSOR"
      },
      {
        "identifier": "71ad4c8f-7da3-5274-b578-4ba73b10f17b",
        "name": "Archive import report",
        "type": "org.apache.nifi.processors.standard.PutFile",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "2.0.0"
        },
        "position": {
          "x": -400,
          "y": 1000
        },
        "properties": {
          "Directory": "/data/webshop/reports",
          "Conflict Resolution Strategy": "replace"
        },
        "schedulingPeriod": "0 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "autoTerminatedRelationships": [
          "success",
          "failure"
        ],
        "componentType": "PROCESSOR"
      },
      {
        "identifier": "331ee155-cffe-5345-91a5-d3529eba3cd0",
        "name": "Retry later",
        "type": "org.apache.nifi.processors.standard.PutFile",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "2.0.0"
        },
        "position": {
          "x": 400,
          "y": 1000
        },
        "properties": {
          "Directory": "/data/webshop/failed",
          "Conflict Resolution Strategy": "replace"
        },
        "schedulingPeriod": "0 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "autoTerminatedRelationships": [
          "success",
          "failure"
        ],
        "componentType": "PROCESSOR"
      },
      {
        "identifier": "a37c04b6-4176-5831-95bc-e1535539e0f0",
        "name": "Every 5 minutes",
        "type": "org.apache.nifi.processors.standard.GenerateFlowFile",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "2.0.0"
        },
        "position": {
          "x": 800,
          "y": 0
        },
        "properties": {
          "Custom Text": "{}"
        },
        "schedulingPeriod": "5 min",
        "schedulingStrategy": "TIMER_DRIVEN",
        "autoTerminatedRelationships": [],
        "componentType": "PROCESSOR"
      },
      {
        "identifier": "532c0eab-6a41-5924-9957-ef62181359e7",
        "name": "Trigger ERP export",
        "type": "org.apache.nifi.processors.standard.InvokeHTTP",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "2.0.0"
        },
        "position": {
          "x": 800,
          "y": 200
        },
        "properties": {
          "HTTP Method": "POST",
          "HTTP URL": "${TOURWERK_API_URL:replaceNull('http://api:4600')}/api/integration/erp/export",
          "Request Content-Type": "application/json",
          "x-integration-token": "#{integration_token}"
        },
        "schedulingPeriod": "0 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "autoTerminatedRelationships": [
          "Original",
          "Response",
          "Retry",
          "No Retry",
          "Failure"
        ],
        "componentType": "PROCESSOR"
      }
    ],
